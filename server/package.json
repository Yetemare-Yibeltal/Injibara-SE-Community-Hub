{
  "name": "injibara-se-community-server",
  "version": "1.0.0",
  "description": "Backend server for Injibara SE Community App - Software Engineering Department communication platform",
  "main": "dist/server/src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch ../shared --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node -r tsconfig-paths/register dist/server/src/server.js",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "test:socket": "ts-node -r tsconfig-paths/register src/scripts/testSocket.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
